{
  "name": "whaleads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p ui --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "node scripts/build-ui.mjs",
    "build:force": "vite build",
    "dev:ui": "vite",
    "test:e2e": "playwright test",
    "lint:template": "node scripts/check-deploy-template.mjs",
    "check": "npm run typecheck && npm run lint:template"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^3.7.0"
  },
  "license": "Apache-2.0",
  "description": "A free WhatsApp lead inbox, CRM and automation builder you deploy to your own Cloudflare account.",
  "cloudflare": {
    "bindings": {
      "SESSION_SECRET": {
        "description": "Signs staff sessions and encrypts your saved WhatsApp connection. Use 32 or more random characters (`openssl rand -hex 32`). Keep a copy: you type it once on the **/setup** page after deploy."
      }
    }
  }
}
